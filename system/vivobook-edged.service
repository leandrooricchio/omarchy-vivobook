[Unit]
Description=Vivobook touchpad edge gestures (brightness, volume, back/forward)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.config/omarchy/plugins/io.github.leandrooricchio.vivobook/bin/vivobook-edged
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
