[Unit]
Description=Re-apply saved Vivobook keyboard, RGB and charge state
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/.config/omarchy/plugins/io.github.leandrooricchio.vivobook/bin/vivobook-ctl apply --json

[Install]
WantedBy=graphical-session.target
