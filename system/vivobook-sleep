#!/bin/bash
# systemd-sleep hook: after resume, restore the charge limit and let each
# logged-in user's session re-apply keyboard state (vivobook-apply.service).
case "$1" in
  post)
    /usr/local/libexec/vivobook-charge restore 2>/dev/null || true
    for user in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
      systemctl --user -M "$user@" start vivobook-apply.service 2>/dev/null || true
    done
    ;;
esac
